# Copy to .env and fill in. Never commit .env.

# Initial admin account (created only if no admin exists yet)
ADMIN_EMAIL=quality.admin@yourcompany.com
ADMIN_PASSWORD=pick-a-strong-password

# Where the SQLite database lives (inside the container: /data)
# CAT_DB_PATH=/data/corrective_actions.db

# Automated escalation sweep interval in hours (0 disables)
ESCALATION_INTERVAL_HOURS=24

# SMTP delivery for notifications (leave SMTP_HOST unset to log-only)
# SMTP_HOST=smtp.yourcompany.com
# SMTP_PORT=587
# SMTP_USER=svc-corrective-actions
# SMTP_PASSWORD=...
# SMTP_FROM=corrective-actions@yourcompany.com
# SMTP_STARTTLS=1
